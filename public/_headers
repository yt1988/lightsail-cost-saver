# Cloudflare / Netlify static headers: let agents and other sites read the public data and module.
/calc.js
  Access-Control-Allow-Origin: *
/prices.json
  Access-Control-Allow-Origin: *
/llms.txt
  Access-Control-Allow-Origin: *
  Content-Type: text/plain; charset=utf-8
# fonts and the content-hashed script never change under the same name
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/assets/js/*
  Cache-Control: public, max-age=31536000, immutable
# logos and favicon keep their names when updated
/assets/logo-light.svg
  Cache-Control: public, max-age=604800
/assets/logo-dark.svg
  Cache-Control: public, max-age=604800
/assets/favicon.svg
  Cache-Control: public, max-age=604800
